# --- Required ---
# JSON array of SMPP logins. One entry per customer.
SMPP_ACCOUNTS=[{"system_id":"customer1","password":"choose-a-strong-password","api_key":"otxt_live_xxxxxxxx","tps":17}]

# Random secret used in the webhook URL path (e.g. openssl rand -hex 24)
GATEWAY_WEBHOOK_TOKEN=replace-with-random-hex

# --- Optional ---
# SMPP listener port. Railway TCP proxy maps a public port to this.
SMPP_PORT=2775
# OpenTxt HTTP API base URL
OPENTXT_API_BASE_URL=https://api.opentxt.ai
# Fallback throughput per account (messages/second)
DEFAULT_TPS=17
# Max concurrent submits per bind before returning ESME_RTHROTTLED
MAX_IN_FLIGHT=200
LOG_LEVEL=info
